# ===== SafeCity — modèle de configuration =====
# Copiez ce fichier en ".env" et adaptez les valeurs.
# En développement, tout fonctionne sans .env (valeurs par défaut sûres).

# --- Environnement : development | production | testing ---
SAFECITY_ENV=development

# --- Sécurité (OBLIGATOIRE en production) ---
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
SAFECITY_SECRET_KEY=change-me-en-production-32-octets-minimum
# SAFECITY_JWT_SECRET=  # par défaut = SECRET_KEY
SAFECITY_JWT_EXPIRES_HOURS=12

# --- Base de données : PostgreSQL (recommandé, dev + prod) ---
# En Docker (« docker compose up »), c'est déjà configuré automatiquement.
# En local hors Docker, lancez d'abord un PostgreSQL puis renseignez :
DATABASE_URL=postgresql+psycopg2://safecity:safecity@localhost:5432/safecity
# Astuce : démarrer seulement la base en Docker →  docker compose up -d db
# Repli SANS installer PostgreSQL (petits essais) : laisser DATABASE_URL vide
# (SQLite local). Les tests automatiques utilisent SQLite en mémoire.

# --- Serveur ---
SAFECITY_HOST=0.0.0.0
SAFECITY_PORT=5000
SAFECITY_SERVER=waitress          # waitress | socketio
# SAFECITY_ASYNC_MODE=eventlet    # pour de vraies websockets

# --- CORS (restreindre en production) ---
SAFECITY_CORS_ORIGINS=*
# SAFECITY_CORS_ORIGINS=https://safecity.example.org,https://admin.example.org

# --- Anti force brute (connexion) ---
SAFECITY_LOGIN_RATE_MAX=8
SAFECITY_LOGIN_RATE_WINDOW=300

# --- Création de comptes personnels depuis le poste opérateur ---
# Code d'invitation exigé pour « Créer un compte » (rôle opérateur) sur le
# bureau. LAISSER VIDE désactive l'auto-inscription (recommandé) : dans ce cas,
# créez les comptes via  python -m backend.manage create-admin.
# Pour autoriser l'inscription, définissez un code secret partagé au personnel :
# SAFECITY_STAFF_INVITE_CODE=un-code-secret

# --- Compte opérateur de démonstration (DÉSACTIVER en production) ---
SAFECITY_SEED_DEMO=true
SAFECITY_DEMO_EMAIL=operateur@safecity.local
SAFECITY_DEMO_PASSWORD=safecity123

# --- Suivi d'erreurs (Sentry) — optionnel, recommandé en production ---
# Alerte automatique en cas d'erreur serveur. Créez un projet sur sentry.io,
# copiez le DSN ici. Laisser vide pour désactiver.
# SAFECITY_SENTRY_DSN=https://xxxx@oyyy.ingest.sentry.io/zzzz
# SAFECITY_SENTRY_TRACES_RATE=0.0

# --- Patrouille par défaut (calcul de distance de secours) ---
SAFECITY_PATROL_LAT=-4.3250
SAFECITY_PATROL_LNG=15.3222

# --- Journalisation ---
SAFECITY_LOG_LEVEL=INFO

# --- Notifications push (optionnel) ---
# Niveaux d'urgence qui déclenchent une notification :
SAFECITY_NOTIFY_LEVELS=haute,critique
# E-mail (SMTP) — codes de vérification (OTP) en repli du SMS + « mot de passe
# oublié » du poste opérateur. Décommentez pour ACTIVER l'envoi d'e-mails.
# GMAIL (recommandé pour démarrer) :
#   1. Connectez-vous au compte Gmail expéditeur.
#   2. Activez la « validation en 2 étapes » (obligatoire).
#   3. Créez un « mot de passe d'application » (16 caractères) :
#      https://myaccount.google.com/apppasswords
#   4. Collez ce mot de passe dans SAFECITY_SMTP_PASSWORD (PAS votre mot de passe
#      Gmail habituel), et mettez votre adresse dans _USER et _FROM.
#   5. Testez : python -m backend.manage test-email --to vous@example.com
SAFECITY_SMTP_HOST=smtp.gmail.com
SAFECITY_SMTP_PORT=587
SAFECITY_SMTP_TLS=true
SAFECITY_SMTP_USER=safecitylubumbashi@gmail.com
SAFECITY_SMTP_PASSWORD=COLLEZ_ICI_LE_MOT_DE_PASSE_APPLICATION_16_CARACTERES
SAFECITY_SMTP_FROM=safecitylubumbashi@gmail.com
# Destinataires des e-mails d'ALERTE (superviseurs), optionnel :
# SAFECITY_SMTP_TO=chef@mairie.local,operateur@mairie.local
# Destinataires SMS des alertes (superviseurs), via la passerelle SMS ci-dessous :
# SAFECITY_SMS_ALERT_TO=+243xxxxxxxxx,+243yyyyyyyyy

# ===========================================================================
# PASSERELLE SMS (codes de vérification OTP + alertes)
# Configurez UNE des trois options ci-dessous. Priorité : Orange > HTTP > AT.
# Repli automatique : si le SMS échoue et que le citoyen a fourni un e-mail
# (SMTP configuré ci-dessus), le code OTP part par e-mail — l'inscription
# continue de fonctionner même en cas de panne SMS.
# ===========================================================================

# --- Option 1 (recommandée RDC) : API SMS Orange RD Congo ---
# Créez une application sur developer.orange.com, souscrivez à l'API « SMS »,
# récupérez le client_id / client_secret et déclarez votre adresse expéditrice.
# SAFECITY_ORANGE_CLIENT_ID=xxxxxxxx
# SAFECITY_ORANGE_CLIENT_SECRET=xxxxxxxx
# SAFECITY_ORANGE_SENDER=tel:+243999999999     # ou un nom court approuvé par Orange
# SAFECITY_ORANGE_TOKEN_URL=https://api.orange.com/oauth/v3/token      # (défaut)
# SAFECITY_ORANGE_SMS_URL=https://api.orange.com/smsmessaging/v1/outbound  # (défaut)

# --- Option 2 : passerelle SMS HTTP générique (autre opérateur/agrégateur RDC) ---
# Adaptez les noms de champs à l'API de votre fournisseur (Vodacom/Airtel/revendeur…).
# Exemple : POST https://api.fournisseur.cd/send  avec {to, message, api_key, sender}
# SAFECITY_SMS_HTTP_URL=https://api.fournisseur.cd/send
# SAFECITY_SMS_HTTP_METHOD=POST                 # POST (défaut) ou GET
# SAFECITY_SMS_HTTP_TO_PARAM=to                 # nom du champ destinataire
# SAFECITY_SMS_HTTP_TEXT_PARAM=message          # nom du champ message
# SAFECITY_SMS_HTTP_JSON=false                  # true = corps JSON, false = formulaire
# SAFECITY_SMS_HTTP_EXTRA=api_key=VOTRE_CLE&sender=SafeCity   # params statiques
# SAFECITY_SMS_HTTP_AUTH_HEADER=Bearer VOTRE_TOKEN            # en-tête Authorization (optionnel)

# --- Option 3 : Africa's Talking (agrégateur régional) ---
# TEST : username=sandbox + clé sandbox (envois simulés, numéros de test).
# PROD : votre username réel + clé de production ; sender ID optionnel.
# SAFECITY_AT_USERNAME=sandbox
# SAFECITY_AT_API_KEY=atsk_xxxxxxxxxxxxxxxx
# SAFECITY_AT_SENDER=SafeCity
# SAFECITY_AT_SANDBOX=true          # true en test, false (ou omis) en production

# --- Vérification du téléphone (OTP) ---
# SAFECITY_OTP_LENGTH=6
# SAFECITY_OTP_TTL_MIN=10          # durée de validité du code (minutes)
# SAFECITY_OTP_MAX_ATTEMPTS=5      # tentatives avant expiration forcée
