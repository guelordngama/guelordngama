# ===== SafeCity — modèle de configuration =====
# Copiez ce fichier en ".env" et adaptez les valeurs.
# En développement, tout fonctionne sans .env (valeurs par défaut sûres).

# --- Environnement : development | production | testing ---
SAFECITY_ENV=development

# --- Sécurité (OBLIGATOIRE en production) ---
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
SAFECITY_SECRET_KEY=change-me-en-production-32-octets-minimum
# SAFECITY_JWT_SECRET=  # par défaut = SECRET_KEY
SAFECITY_JWT_EXPIRES_HOURS=12

# --- Base de données ---
# SQLite (dev, défaut) : laisser vide
# PostgreSQL (prod) :
# DATABASE_URL=postgresql+psycopg2://safecity:motdepasse@db:5432/safecity

# --- Serveur ---
SAFECITY_HOST=0.0.0.0
SAFECITY_PORT=5000
SAFECITY_SERVER=waitress          # waitress | socketio
# SAFECITY_ASYNC_MODE=eventlet    # pour de vraies websockets

# --- CORS (restreindre en production) ---
SAFECITY_CORS_ORIGINS=*
# SAFECITY_CORS_ORIGINS=https://safecity.example.org,https://admin.example.org

# --- Anti force brute (connexion) ---
SAFECITY_LOGIN_RATE_MAX=8
SAFECITY_LOGIN_RATE_WINDOW=300

# --- Compte opérateur de démonstration (DÉSACTIVER en production) ---
SAFECITY_SEED_DEMO=true
SAFECITY_DEMO_EMAIL=operateur@safecity.local
SAFECITY_DEMO_PASSWORD=safecity123

# --- Patrouille par défaut (calcul de distance de secours) ---
SAFECITY_PATROL_LAT=-4.3250
SAFECITY_PATROL_LNG=15.3222

# --- Journalisation ---
SAFECITY_LOG_LEVEL=INFO
