# ===== SafeCity — Reverse proxy Nginx (production) =====
# Deux domaines servis par le même serveur :
#   • ${SAFECITY_DOMAIN}         → application citoyenne (et /portal/ en secours)
#   • ${SAFECITY_PORTAL_DOMAIN}  → portail des agents (à la racine)
# L'API REST, les fichiers envoyés et Socket.IO (temps réel) sont proxifiés vers
# le backend sur les deux domaines (voir snippets/safecity_proxy.conf).
#
# Renseignez SAFECITY_DOMAIN et SAFECITY_PORTAL_DOMAIN dans deploy/.env.prod.

upstream safecity_backend {
    server backend:5000;
}

# --- HTTP : redirige vers HTTPS + sert le challenge Certbot (les 2 domaines) ---
server {
    listen 80;
    server_name ${SAFECITY_DOMAIN} ${SAFECITY_PORTAL_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS : application citoyenne (domaine principal) ---
server {
    listen 443 ssl;
    http2 on;
    server_name ${SAFECITY_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${SAFECITY_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SAFECITY_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 20m;

    include /etc/nginx/snippets/safecity_proxy.conf;

    # Portail agents aussi accessible sous /portal/ (compatibilité / secours).
    location /portal/ {
        alias /usr/share/nginx/portal/;
        index index.html;
        try_files $uri $uri/ /portal/index.html;
    }

    # Application citoyenne (statique).
    location / {
        root /usr/share/nginx/web;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}

# --- HTTPS : portail des agents (sous-domaine dédié) ---
server {
    listen 443 ssl;
    http2 on;
    server_name ${SAFECITY_PORTAL_DOMAIN};

    # Même certificat (émis avec les deux domaines en SAN).
    ssl_certificate     /etc/letsencrypt/live/${SAFECITY_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SAFECITY_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 20m;

    include /etc/nginx/snippets/safecity_proxy.conf;

    # Portail agents à la racine du sous-domaine.
    location / {
        root /usr/share/nginx/portal;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
