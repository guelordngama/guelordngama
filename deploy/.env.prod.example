# ===== SafeCity — Configuration de PRODUCTION =====
# Copiez ce fichier en deploy/.env.prod puis adaptez les valeurs.

# --- Domaines HTTPS ---
# Let's Encrypt exige un nom de domaine (pas une IP nue). Astuce sans acheter
# de domaine : sslip.io transforme votre IP en nom valide.
#   IP 203.0.113.10  ->  203-0-113-10.sslip.io
# Domaine principal = application citoyenne.
SAFECITY_DOMAIN=safecity-lubumbashi.com
# Sous-domaine dédié au PORTAIL DES AGENTS (créez un enregistrement DNS « A »
# qui pointe vers la même IP que le domaine principal). Le portail reste aussi
# accessible via https://SAFECITY_DOMAIN/portal/.
SAFECITY_PORTAL_DOMAIN=agents.safecity-lubumbashi.com
CERTBOT_EMAIL=vous@exemple.com

# --- Sécurité (OBLIGATOIRE) ---
# Générer : python3 -c "import secrets; print(secrets.token_hex(32))"
SAFECITY_SECRET_KEY=CHANGEZ-MOI-cle-de-32-octets-minimum
POSTGRES_PASSWORD=CHANGEZ-MOI-mot-de-passe-postgres

# --- CORS : origines autorisées (les DEUX domaines en HTTPS, séparés par ,) ---
SAFECITY_CORS_ORIGINS=https://safecity-lubumbashi.com,https://agents.safecity-lubumbashi.com

# --- Compte opérateur de démonstration (mettre false en vraie prod) ---
SAFECITY_SEED_DEMO=true

# --- Sauvegardes ---
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
