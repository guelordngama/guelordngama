# ===== SafeCity — Configuration de PRODUCTION =====
# Copiez ce fichier en deploy/.env.prod puis adaptez les valeurs.

# --- Domaine HTTPS ---
# Préconfiguré pour le domaine DuckDNS du serveur SafeCity.
# DuckDNS fait pointer un nom gratuit vers votre IP :
#   safecity-rdc.duckdns.org  ->  169.58.47.76
# Vérifiez que l'enregistrement DuckDNS pointe bien vers cette IP avant l'émission
# du certificat. (Alternative sans configuration : 169-58-47-76.sslip.io)
SAFECITY_DOMAIN=safecity-rdc.duckdns.org
CERTBOT_EMAIL=lucangama20@gmail.com

# --- Sécurité (OBLIGATOIRE) ---
# Générer : python3 -c "import secrets; print(secrets.token_hex(32))"
SAFECITY_SECRET_KEY=CHANGEZ-MOI-cle-de-32-octets-minimum
POSTGRES_PASSWORD=CHANGEZ-MOI-mot-de-passe-postgres

# --- CORS : origine(s) autorisée(s) (votre domaine en HTTPS) ---
SAFECITY_CORS_ORIGINS=https://safecity-rdc.duckdns.org

# --- Compte opérateur de démonstration (mettre false en vraie prod) ---
SAFECITY_SEED_DEMO=true

# --- Sauvegardes ---
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
